{
  "name": "kivi",
  "private": true,
  "version": "0.0.1",
  "description": "High-performance WYSIWYG Markdown editor and knowledge management system",
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm build && pnpm --filter @kivi/web-demo dev",
    "dev:ext": "pnpm build && pnpm --filter kivi dev",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @kivi/markdown-parser test && pnpm --filter @kivi/markdown-serializer test && pnpm --filter @kivi/editor-core test && pnpm --filter @kivi/vault test",
    "test:vscode": "pnpm --filter kivi test",
    "test:ui": "bash tests/ui/browser-test.sh",
    "test:all": "pnpm test:unit && pnpm test:vscode && pnpm test:ui",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9",
    "playwright": "^1.58.2",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "^5.7"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
