{
  "name": "@kivi/editor-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kivi/markdown-parser": "workspace:*",
    "@kivi/markdown-serializer": "workspace:*",
    "@kivi/shared-types": "workspace:*",
    "@tiptap/core": "^2",
    "@tiptap/extension-image": "^2",
    "@tiptap/extension-link": "^2",
    "@tiptap/extension-placeholder": "^2",
    "@tiptap/extension-table": "^2",
    "@tiptap/extension-table-cell": "^2",
    "@tiptap/extension-table-header": "^2",
    "@tiptap/extension-table-row": "^2",
    "@tiptap/extension-task-item": "^2",
    "@tiptap/extension-task-list": "^2",
    "@tiptap/extension-underline": "^2",
    "@tiptap/pm": "^2",
    "@tiptap/starter-kit": "^2",
    "lowlight": "^3.3.0"
  },
  "devDependencies": {
    "happy-dom": "^20.8.9",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
