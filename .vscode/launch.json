{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Kivi Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension",
        "${workspaceFolder}/apps/vscode-extension/test-fixtures"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "build-extension"
    }
  ]
}
