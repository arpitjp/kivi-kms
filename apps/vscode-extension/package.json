{
  "name": "kivi",
  "displayName": "Kivi",
  "description": "WYSIWYG Markdown editor and knowledge management system",
  "version": "0.0.1",
  "publisher": "kivi",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCustomEditor:kivi.markdownEditor"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "kivi.markdownEditor",
        "displayName": "Kivi Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kivi",
          "title": "Kivi",
          "icon": "images/kivi-sidebar.svg"
        }
      ]
    },
    "views": {
      "kivi": [
        {
          "id": "kivi.files",
          "name": "Files"
        },
        {
          "id": "kivi.outline",
          "name": "Outline"
        },
        {
          "id": "kivi.backlinks",
          "name": "Backlinks"
        },
        {
          "id": "kivi.tags",
          "name": "Tags"
        },
        {
          "id": "kivi.issues",
          "name": "Issues",
          "visibility": "collapsed"
        },
        {
          "id": "kivi.assets",
          "name": "Assets",
          "visibility": "collapsed"
        }
      ]
    },
    "commands": [
      {
        "command": "kivi.openInKivi",
        "title": "Open in Kivi",
        "category": "Kivi",
        "icon": {
          "dark": "images/kivi-dark.svg",
          "light": "images/kivi-light.svg"
        }
      },
      {
        "command": "kivi.openWithTextEditor",
        "title": "Open with Text Editor",
        "category": "Kivi"
      },
      {
        "command": "kivi.createExcalidraw",
        "title": "Create Excalidraw Diagram",
        "category": "Kivi",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "kivi.openGraph",
        "title": "Open Graph View",
        "category": "Kivi",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "kivi.refreshFiles",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.collapseFiles",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kivi.refreshOutline",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.refreshBacklinks",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.refreshTags",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.collapseOutline",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kivi.expandOutline",
        "title": "Expand All",
        "icon": "$(expand-all)"
      },
      {
        "command": "kivi.collapseTags",
        "title": "Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kivi.refreshIssues",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.refreshAssets",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "kivi.searchTag",
        "title": "Search Tag in Workspace",
        "category": "Kivi"
      },
      {
        "command": "kivi.openGraphGlobal",
        "title": "Open Global Graph",
        "category": "Kivi",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "kivi.showGraphInTab",
        "title": "Show Graph for Current File",
        "category": "Kivi",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "kivi.setDefaultEditor",
        "title": "Make Kivi Default Markdown Editor",
        "category": "Kivi"
      },
      {
        "command": "kivi.removeDefaultEditor",
        "title": "Remove Kivi as Default Markdown Editor",
        "category": "Kivi"
      },
      {
        "command": "kivi.openToSide",
        "title": "Open to Side",
        "category": "Kivi",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "kivi.revealInExplorer",
        "title": "Reveal in Explorer",
        "category": "Kivi",
        "icon": "$(file-symlink-directory)"
      },
      {
        "command": "kivi.openDevTools",
        "title": "Open Dev Tools",
        "category": "Kivi",
        "icon": "$(debug-console)"
      },
      {
        "command": "kivi.copyOutlineLink",
        "title": "Copy Link",
        "category": "Kivi",
        "icon": "$(link)"
      },
      {
        "command": "kivi.copyAsReference",
        "title": "Copy as Kivi Reference",
        "category": "Kivi",
        "icon": "$(copy)"
      },
      {
        "command": "kivi.find",
        "title": "Find",
        "category": "Kivi"
      },
      {
        "command": "kivi.findReplace",
        "title": "Find and Replace",
        "category": "Kivi"
      },
      {
        "command": "kivi.toggleBlame",
        "title": "Toggle Git Blame",
        "category": "Kivi"
      },
      {
        "command": "kivi.createPage",
        "title": "Create New Page",
        "category": "Kivi",
        "icon": "$(new-file)"
      },
      {
        "command": "kivi.scanIssues",
        "title": "Scan for Broken Links & Orphan Assets",
        "category": "Kivi",
        "icon": "$(search)"
      }
    ],
    "keybindings": [
      {
        "command": "kivi.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == kivi.markdownEditor"
      },
      {
        "command": "kivi.findReplace",
        "key": "ctrl+h",
        "mac": "cmd+alt+f",
        "when": "activeCustomEditorId == kivi.markdownEditor"
      },
      {
        "command": "kivi.toggleBlame",
        "key": "ctrl+shift+g b",
        "mac": "cmd+shift+g b",
        "when": "activeCustomEditorId == kivi.markdownEditor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "kivi.openInKivi",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "kivi.openWithTextEditor",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "kivi.copyAsReference",
          "when": "kivi.isActive"
        },
        {
          "command": "kivi.find",
          "when": "activeCustomEditorId == kivi.markdownEditor"
        },
        {
          "command": "kivi.findReplace",
          "when": "activeCustomEditorId == kivi.markdownEditor"
        },
        {
          "command": "kivi.toggleBlame",
          "when": "activeCustomEditorId == kivi.markdownEditor"
        },
        {
          "command": "kivi.refreshFiles",
          "when": "false"
        },
        {
          "command": "kivi.collapseFiles",
          "when": "false"
        },
        {
          "command": "kivi.refreshOutline",
          "when": "false"
        },
        {
          "command": "kivi.refreshBacklinks",
          "when": "false"
        },
        {
          "command": "kivi.refreshTags",
          "when": "false"
        },
        {
          "command": "kivi.collapseOutline",
          "when": "false"
        },
        {
          "command": "kivi.expandOutline",
          "when": "false"
        },
        {
          "command": "kivi.copyOutlineLink",
          "when": "false"
        },
        {
          "command": "kivi.collapseTags",
          "when": "false"
        },
        {
          "command": "kivi.searchTag",
          "when": "false"
        },
        {
          "command": "kivi.openGraphGlobal",
          "when": "kivi.isActive"
        },
        {
          "command": "kivi.showGraphInTab",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "kivi.setDefaultEditor",
          "when": "kivi.isActive && !config.kivi.defaultEditor"
        },
        {
          "command": "kivi.removeDefaultEditor",
          "when": "kivi.isActive && config.kivi.defaultEditor"
        },
        {
          "command": "kivi.openToSide",
          "when": "resourceExtname == .md || resourceExtname == .markdown"
        },
        {
          "command": "kivi.revealInExplorer",
          "when": "kivi.editorFocused"
        },
        {
          "command": "kivi.openDevTools",
          "when": "kivi.devMode"
        },
        {
          "command": "kivi.refreshIssues",
          "when": "false"
        },
        {
          "command": "kivi.refreshAssets",
          "when": "false"
        },
        {
          "command": "kivi.openGraph",
          "when": "false"
        },
        {
          "command": "kivi.createPage",
          "when": "kivi.isActive"
        },
        {
          "command": "kivi.scanIssues",
          "when": "kivi.isActive"
        }
      ],
      "explorer/context": [
        {
          "command": "kivi.openInKivi",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@1"
        },
        {
          "command": "kivi.openToSide",
          "when": "resourceExtname == .md || resourceExtname == .markdown",
          "group": "navigation@2"
        },
        {
          "command": "kivi.copyAsReference",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .png || resourceExtname == .jpg || resourceExtname == .jpeg || resourceExtname == .gif || resourceExtname == .svg || resourceExtname == .webp || resourceExtname == .excalidraw",
          "group": "9_cutcopypaste@10"
        }
      ],
      "editor/title": [
        {
          "command": "kivi.openWithTextEditor",
          "when": "kivi.editorFocused",
          "group": "navigation@1"
        },
        {
          "command": "kivi.showGraphInTab",
          "when": "kivi.editorFocused",
          "group": "navigation@2"
        }
      ],
      "editor/title/context": [
        {
          "command": "kivi.revealInExplorer",
          "when": "kivi.editorFocused",
          "group": "1_kivi"
        },
        {
          "command": "kivi.openWithTextEditor",
          "when": "kivi.editorFocused",
          "group": "1_kivi"
        }
      ],
      "view/title": [
        {
          "command": "kivi.refreshFiles",
          "when": "view == kivi.files",
          "group": "navigation"
        },
        {
          "command": "kivi.collapseFiles",
          "when": "view == kivi.files",
          "group": "navigation"
        },
        {
          "command": "kivi.refreshOutline",
          "when": "view == kivi.outline",
          "group": "navigation"
        },
        {
          "command": "kivi.expandOutline",
          "when": "view == kivi.outline",
          "group": "navigation"
        },
        {
          "command": "kivi.collapseOutline",
          "when": "view == kivi.outline",
          "group": "navigation"
        },
        {
          "command": "kivi.refreshBacklinks",
          "when": "view == kivi.backlinks",
          "group": "navigation"
        },
        {
          "command": "kivi.refreshTags",
          "when": "view == kivi.tags",
          "group": "navigation"
        },
        {
          "command": "kivi.collapseTags",
          "when": "view == kivi.tags",
          "group": "navigation"
        },
        {
          "command": "kivi.refreshIssues",
          "when": "view == kivi.issues",
          "group": "navigation"
        },
        {
          "command": "kivi.refreshAssets",
          "when": "view == kivi.assets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kivi.copyOutlineLink",
          "when": "view == kivi.outline && viewItem == kiviOutlineHeading",
          "group": "inline"
        },
        {
          "command": "kivi.copyOutlineLink",
          "when": "view == kivi.outline && viewItem == kiviOutlineHeading",
          "group": "1_copy"
        }
      ]
    },
    "configuration": {
      "title": "Kivi",
      "properties": {
        "kivi.defaultEditor": {
          "type": "boolean",
          "default": true,
          "description": "Use Kivi as the default editor for Markdown files. When disabled, Markdown files open in the text editor and you can use 'Kivi: Open in Kivi' to open individual files."
        },
        "kivi.appearance.editorBackground": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the editor background color (e.g. `#1f1f1f`). Leave empty to inherit from the current VS Code theme."
        },
        "kivi.appearance.codeBlockBackground": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the code block background color (e.g. `#181818`). Leave empty to use the default."
        },
        "kivi.appearance.accentColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the accent/link color (e.g. `#4daafc`). Leave empty to inherit from the current VS Code theme."
        },
        "kivi.appearance.textColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the main editor text color (e.g. `#d4d4d4`). Leave empty to inherit from the current VS Code theme."
        },
        "kivi.appearance.headingColor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Override the heading text color (e.g. `#e6e6e6`). Leave empty to derive from the text color."
        },
        "kivi.appearance.fontSize": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "markdownDescription": "Editor font size in pixels. Set to `0` to inherit from VS Code's `editor.fontSize`."
        },
        "kivi.appearance.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Editor font family (e.g. `'Inter', sans-serif`). Leave empty to inherit from VS Code's `editor.fontFamily`."
        },
        "kivi.appearance.lineHeight": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 5,
          "markdownDescription": "Editor line height as a unitless ratio (e.g. `1.7`). Set to `0` for the default."
        },
        "kivi.appearance.editorZoom": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "markdownDescription": "Extra zoom for the Kivi editor area (live + raw) as a percentage. `100` = no extra zoom. `120` = 20% larger. Applied via CSS zoom on top of VS Code's `window.zoomLevel` (which affects the whole webview). Does **not** affect the toolbar."
        },
        "kivi.appearance.wordWrap": {
          "type": "string",
          "enum": [
            "inherit",
            "on",
            "off"
          ],
          "default": "inherit",
          "markdownDescription": "Word wrap in Kivi editors. `inherit` uses VS Code's `editor.wordWrap` setting. `on` / `off` override it for Kivi only."
        },
        "kivi.appearance.customCSS": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "Custom CSS to inject into the Kivi editor webview. Useful for advanced theming. Example:\n```css\n.kivi-vscode-editor h1 { color: #ff8800; }\n```"
        },
        "kivi.ui.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "Show the formatting toolbar at the top of the editor."
        },
        "kivi.folders.pages": {
          "type": "string",
          "default": "pages",
          "markdownDescription": "Folder name for new child pages. Created as a sibling folder next to the current `.md` file (e.g. `docs/readme.md` → `docs/pages/`)."
        },
        "kivi.folders.assets": {
          "type": "string",
          "default": "assets",
          "markdownDescription": "Folder name for pasted images and other assets. Created as a sibling folder next to the current `.md` file (e.g. `docs/readme.md` → `docs/assets/`)."
        },
        "kivi.stickyScroll.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a sticky header with the current heading hierarchy while scrolling."
        },
        "kivi.stickyScroll.maxDepth": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 6,
          "description": "Maximum heading depth to show in sticky scroll (1 = H1 only, 6 = all levels)."
        },
        "kivi.dev.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Kivi developer tools (logs, perf, state inspector). Automatically on in Extension Development Host. Set via settings JSON for production debugging."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "clean": "rm -rf dist out",
    "pretest": "node build.mjs && tsc -p tsconfig.test.json",
    "test": "NODE_TLS_REJECT_UNAUTHORIZED=0 vscode-test",
    "test:unit": "vitest run",
    "package": "vsce package"
  },
  "dependencies": {
    "@excalidraw/utils": "^0.1.3-test32",
    "@kivi/editor-core": "workspace:*",
    "@kivi/shared-types": "workspace:*",
    "@kivi/vault": "workspace:*",
    "katex": "^0.16.44",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.24",
    "glob": "^13.0.6",
    "typescript": "^5.7",
    "vite": "^6",
    "vitest": "^3"
  }
}
