{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "types": ["mocha", "node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./out/test",
    "rootDir": "./src/test",
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["src/test/**/*.ts"]
}
